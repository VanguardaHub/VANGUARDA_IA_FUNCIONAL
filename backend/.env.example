# ============================================================
# Vanguarda.IA — configuração do backend
# Copie para backend/.env e preencha. NUNCA versione o .env.
# ============================================================

# ---- Banco de dados (OBRIGATÓRIO) ----
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=vanguarda_ia

# ---- Sessão (OBRIGATÓRIO) ----
# Gere com: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio

# ---- Cookies de sessão ----
# Padrão de produção: Secure + SameSite=none (exige HTTPS).
# Em desenvolvimento local sobre http:// o navegador DESCARTA um cookie Secure,
# então o login nunca completa. Para rodar em localhost, use:
#   COOKIE_SECURE=false
#   COOKIE_SAMESITE=lax
COOKIE_SECURE=true
COOKIE_SAMESITE=none

# ---- URL pública do frontend (OBRIGATÓRIO) ----
# Usada no CORS e nos links de redefinição de senha.
FRONTEND_URL=http://localhost:3000

# ---- Administrador semeado no primeiro start (OBRIGATÓRIO) ----
# Se omitidos, o padrão do código é admin@example.com / admin123 — inseguro.
# Atencao: dominios reservados (.local, .test, .invalid) sao rejeitados
# pelo validador de e-mail e quebram o login. Use um dominio real.
ADMIN_EMAIL=voce@suaagencia.com.br
ADMIN_PASSWORD=defina-uma-senha-forte

# ---- Provedores de IA ----
# Necessários para gerar peças e consultar a Bíblia.
# ANTHROPIC_API_KEY habilita o modelo Claude Sonnet 4.6.
# OPENAI_API_KEY habilita o GPT-5.4 Mini e a geração de imagem (GPT Image 1).
# Você pode definir apenas um; o modelo sem chave falhará ao ser selecionado.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- Pagamentos Stripe (OPCIONAL — só para assinaturas) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- E-mail de redefinição de senha (OPCIONAL) ----
# Herdado da plataforma Emergent; sem estes valores o reset por e-mail fica inativo.
EMERGENT_EMAIL_KEY=
INTEGRATION_PROXY_URL=
EMAIL_FROM_NAME=Vanguarda.IA

# ---- Compatibilidade (OPCIONAL) ----
# Chave universal da Emergent. Se preenchida, serve de fallback quando
# ANTHROPIC_API_KEY / OPENAI_API_KEY não estiverem definidas.
EMERGENT_LLM_KEY=
